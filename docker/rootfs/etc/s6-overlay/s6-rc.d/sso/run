#!/command/with-contenv bash
# shellcheck shell=bash

set -e

. /usr/bin/common.sh

cd /app/sso || exit 1

log_info 'Starting SSO sidecar ...'

if [ ! -d "node_modules" ]; then
	# Dependencies are installed at image build time (docker/Dockerfile).
	# In development the backend's node_modules are shared via the volume.
	if [ "${DEVELOPMENT:-}" = 'true' ]; then
		s6-setuidgid "$PUID:$PGID" npm ci --omit=dev
	else
		log_fatal 'SSO sidecar dependencies are missing from the image'
	fi
fi

while :
do
	s6-setuidgid "$PUID:$PGID" bash -c "export HOME=$NPMHOME;node --abort_on_uncaught_exception server.js"
	sleep 1
done
